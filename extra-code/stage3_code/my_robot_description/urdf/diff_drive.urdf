<?xml version="1.0"?>
<!--
  文件说明：纯手写的差速驱动（diff drive）机器人 URDF。
  演示概念：多个 link 用 joint 连接成树、continuous 关节、
  material 颜色、rpy 旋转让圆柱体侧躺当轮子。
  查看方式：
    ros2 launch my_robot_description minimal_display.launch.py \
      model:=diff_drive.urdf
-->
<robot name="diff_drive_robot">

  <!-- material：定义可复用的颜色，rgba 各分量取值 0~1，
       a 是不透明度（1.0 = 完全不透明） -->
  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <!-- 底盘：0.5 x 0.3 x 0.1 m 的盒子，上移半个高度使底面贴地 -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.3 0.1"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <!-- 轮子：cylinder 默认轴向是 z 轴（立着的），
       rpy 第一项 roll=1.5708（约 90°）让它绕 x 轴翻转侧躺，
       轴向变成 y 轴，才像一个车轮 -->
  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <!-- 传感器立柱：竖直圆柱，origin 上移使柱底与 link 原点对齐 -->
  <link name="sensor_mast">
    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.3"/>
      </geometry>
      <material name="grey"/>
    </visual>
  </link>

  <!-- joint 连接 parent 和 child 两个 link，组成一棵树。
       type="continuous"：可无限旋转的关节，适合车轮。
       origin：child 原点在 parent 坐标系中的位置——
       左轮在 y=+0.175（左侧），轮轴高度 z=0.05。
       axis：旋转轴方向，"0 1 0" 表示绕 y 轴转 -->
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.175 0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- 右轮与左轮对称，只是 y 取负值（右侧） -->
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.175 0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- type="fixed"：固定关节，立柱与底盘之间没有相对运动 -->
  <joint name="base_to_mast" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_mast"/>
    <origin xyz="0.15 0 0.1" rpy="0 0 0"/>
  </joint>

</robot>

