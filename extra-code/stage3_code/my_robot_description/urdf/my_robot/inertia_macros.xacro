<?xml version="1.0"?>
<!--
  文件说明：常用几何体的惯性矩阵（inertia）macro 集合。
  惯性矩阵描述刚体绕各轴的转动惯量，是 Gazebo 物理仿真的
  必要输入；随手乱填会让机器人抖动、打滑甚至翻倒。
  这里按"实心均质几何体"的标准公式计算，调用时传入
  mass 和尺寸即可展开成正确的 <inertia> 标签。
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 实心长方体：ixx = m/12*(y^2+z^2)，其余轴同理 -->
  <xacro:macro name="inertia_box" params="mass x y z">
    <inertia
      ixx="${mass / 12.0 * (y*y + z*z)}"
      ixy="0" ixz="0"
      iyy="${mass / 12.0 * (x*x + z*z)}"
      iyz="0"
      izz="${mass / 12.0 * (x*x + y*y)}"/>
  </xacro:macro>

  <!-- Cylinder whose axis is the link y-axis, used by side-mounted wheels. -->
  <xacro:macro name="inertia_cylinder_y" params="mass radius length">
    <inertia
      ixx="${mass / 12.0 * (3.0*radius*radius + length*length)}"
      ixy="0" ixz="0"
      iyy="${mass / 2.0 * radius*radius}"
      iyz="0"
      izz="${mass / 12.0 * (3.0*radius*radius + length*length)}"/>
  </xacro:macro>

  <!-- Cylinder whose axis is the link z-axis, used by the lidar puck. -->
  <xacro:macro name="inertia_cylinder_z" params="mass radius length">
    <inertia
      ixx="${mass / 12.0 * (3.0*radius*radius + length*length)}"
      ixy="0" ixz="0"
      iyy="${mass / 12.0 * (3.0*radius*radius + length*length)}"
      iyz="0"
      izz="${mass / 2.0 * radius*radius}"/>
  </xacro:macro>

</robot>
