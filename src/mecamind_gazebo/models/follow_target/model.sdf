<?xml version="1.0"?>
<!--
  视觉跟随用的红色圆柱目标。

  【尺寸故意偏细】半径 0.10m：在车前方约 1m 处，画面里宽度大约
  0.15~0.20（小于控制器 desired_width=0.25），这样才会触发前进；
  若做成粗柱贴脸，车只会原地转向、几乎不往前开。

  static=true：位姿由 follow_target_mover 通过 gz set_pose 驱动。
-->
<sdf version="1.9">
  <model name="follow_target">
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>
    <link name="body">
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.75</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1.0 0.0 0.0 1</ambient>
          <diffuse>1.0 0.05 0.05 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
          <emissive>0.85 0.0 0.0 1</emissive>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.75</length>
          </cylinder>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
